# ================================================
# PRODUCTION-LEVEL ENVIRONMENT CONFIGURATION
# ================================================
# This file is a reference for all environment variables
# Copy backend/.env.example → backend/.env
# Copy frontend/.env.example → frontend/.env

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=5000
ENVIRONMENT=development

# ============================================
# MongoDB Configuration
# ============================================
MONGO_URI=mongodb://localhost:27017/performance-tracker
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123
MONGO_DATABASE=performance_tracker

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ============================================
# Frontend Configuration
# ============================================
REACT_APP_API_URL=http://localhost:5000
REACT_APP_ENV=development

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./backend/uploads

# ============================================
# API Configuration
# ============================================
API_VERSION=v1
REQUEST_TIMEOUT=30000

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
