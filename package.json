{
  "name": "performance-tracker",
  "version": "1.0.0",
  "description": "Production-ready performance tracking API for agent management",
  "main": "server/src/app.js",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server/src/app.js",
    "dev": "node server/src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint server/src/",
    "lint:fix": "eslint server/src/ --fix",
    "prod": "NODE_ENV=production node server/src/app.js",
    "docker:build": "docker build -t performance-tracker:latest .",
    "docker:build:prod": "docker build -t performance-tracker:production --target production .",
    "docker:up": "docker-compose up -d",
    "docker:up:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:test": "docker-compose run --rm app npm test"
  },
  "keywords": [
    "performance",
    "tracking",
    "agent",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.44.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
