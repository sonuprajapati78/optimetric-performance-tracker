# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database Configuration
# ============================================
# MongoDB Connection String
# Local: mongodb://localhost:27017/performance_tracker
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/performance_tracker
MONGO_URI=mongodb://admin:admin123@mongodb:27017/performance_tracker?authSource=admin

# Optional: Database name (if using connection string without database)
# MONGO_DB_NAME=performance_tracker

# ============================================
# Authentication
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRE=30d

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=.xlsx,.xls,.csv

# ============================================
# Email Configuration (if applicable)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# ============================================
# API Settings
# ============================================
API_VERSION=v1
API_TIMEOUT=30000

# ============================================
# External Services
# ============================================
# Add any external service URLs/keys here
# STRIPE_KEY=pk_test_...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ============================================
# Redis (if using caching)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# Environment-specific settings
# ============================================
# Development
DEBUG=true

# Production (uncomment for production)
# NODE_ENV=production
# LOG_LEVEL=error
# DEBUG=false
