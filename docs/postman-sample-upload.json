{
  "info": {
    "name": "Performance Tracker Upload Sample",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload Performance Excel",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "<path-to-your-excel-file.xlsx>"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/api/performance/upload",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "performance", "upload"]
        }
      },
      "response": []
    }
  ]
}
