# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Configuration
# ============================================
# Backend API URL
# Development: http://localhost:5000
# Production: https://api.yourdomain.com
REACT_APP_API_URL=http://localhost:5000

# ============================================
# Environment Settings
# ============================================
REACT_APP_ENV=development

# ============================================
# App Information
# ============================================
REACT_APP_NAME=Performance Tracker
REACT_APP_VERSION=1.0.0

# ============================================
# Feature Flags
# ============================================
# REACT_APP_ENABLE_ANALYTICS=true
# REACT_APP_ENABLE_EXPERIMENTAL=false

# ============================================
# Third-party Services
# ============================================
# Google Analytics
# REACT_APP_GA_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
# REACT_APP_SENTRY_DSN=https://...

# Auth0 / Firebase (if applicable)
# REACT_APP_AUTH_DOMAIN=your-domain.auth0.com
# REACT_APP_CLIENT_ID=your-client-id

# ============================================
# Build Settings
# ============================================
# Browser compatibility
BROWSER=chrome

# ============================================
# Port Configuration
# ============================================
PORT=3000

# ============================================
# Debug Settings
# ============================================
REACT_APP_DEBUG=false
REACT_APP_LOG_LEVEL=info

# ============================================
# Production Settings (uncomment for prod)
# ============================================
# REACT_APP_ENV=production
# REACT_APP_API_URL=https://api.yourdomain.com
# REACT_APP_DEBUG=false
